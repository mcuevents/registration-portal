# ONEZONE 2K26 Portal - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit real credentials to version control.

# Supabase PostgreSQL Cloud Configuration (Found in Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional: Admin Secret Passcode for local/demo login
VITE_ADMIN_PASSCODE=your_secure_admin_passcode_here
